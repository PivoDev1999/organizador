# Copy to .env and replace every "change-me" value:
#   cp .env.example .env

# --- App ---
ENVIRONMENT=development
# Signs the login tokens. At least 32 characters in every environment:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Port of the API in development (uvicorn outside Docker; the Vite proxy reads it too)
API_PORT=8000

# --- Production stack (docker compose up -d --build) ---
# Port of the web server (Nginx: app + /api) on the home network: http://<server-IP>:HTTP_PORT
# The only port of the stack open to the network. Use another one (e.g. 8088) if 80 is taken.
HTTP_PORT=80
# Uvicorn worker processes of the `api` container (1-2 is plenty for a household)
API_WORKERS=2
# RAM disk (/tmp) of the `api` container, where uploads are spooled: keep room for a few simultaneous
# uploads of MAX_UPLOAD_MB (256m = about 12 x 20 MB). A full /tmp fails that upload, never the host.
API_TMP_SIZE=256m
# Internal Docker network shared only by Nginx and the API; uvicorn trusts X-Forwarded-For from it.
# Change it only if it clashes with another network of the server.
PROXY_SUBNET=172.31.250.0/28

# --- Auth ---
# Login token lifetime in minutes (10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Allow new accounts via POST /api/auth/register. Development only (uvicorn): the Docker stack always runs
# with ALLOW_REGISTRATION=false and ENVIRONMENT=production, whatever this file says. Production accounts:
#   docker compose exec api python -m scripts.create_user --email ana@casa.local --name "Ana"
ALLOW_REGISTRATION=false
# IANA time zone used to decide what "today" is
APP_TIMEZONE=America/Sao_Paulo

# --- PostgreSQL (bound to 127.0.0.1 only) ---
# POSTGRES_HOST/POSTGRES_PORT are for development: inside Docker the API uses postgres:5432.
POSTGRES_USER=organizador
POSTGRES_PASSWORD=change-me
POSTGRES_DB=organizador
POSTGRES_TEST_DB=organizador_test
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Garage (S3-compatible storage, bound to 127.0.0.1 only) ---
# openssl rand -hex 32
GARAGE_RPC_SECRET=change-me
# openssl rand -base64 32
GARAGE_ADMIN_TOKEN=change-me
# Disk space Garage may use on the server
GARAGE_CAPACITY=10G

# --- S3 client (used by the API; the key is created by the garage-init service) ---
S3_PORT=3900
# For development: inside Docker the API uses http://garage:3900.
S3_ENDPOINT_URL=http://localhost:3900
S3_REGION=garage
# Garage format: "GK" + 24 hex chars -> echo "GK$(openssl rand -hex 12)"
S3_ACCESS_KEY_ID=GK000000000000000000000000
# 64 hex chars -> openssl rand -hex 32
S3_SECRET_ACCESS_KEY=change-me
S3_BUCKET=organizador
# Bucket for the storage integration tests (created by garage-init with the same key)
S3_TEST_BUCKET=organizador-test

# --- Uploads ---
# Maximum size of each uploaded file, in MB (1 MB = 1024 * 1024 bytes); larger uploads get 413.
# Nginx accepts up to MAX_UPLOAD_MB + 2 MB on /api/files (room for the multipart envelope).
MAX_UPLOAD_MB=20

# --- Backups (`backup` service: every day at 03:00 in APP_TIMEZONE, into ./backups) ---
# Owner (uid/gid) of the backup files: the owner of the repository (`id -u` and `id -g`), so the files can be
# read, copied and deleted without sudo. The backup container runs as this uid.
BACKUP_UID=1000
BACKUP_GID=1000

# --- Adminer (bound to 127.0.0.1 only) ---
ADMINER_PORT=8080

# --- Seed (demo user: demo@organizador.local) ---
SEED_USER_PASSWORD=change-me
